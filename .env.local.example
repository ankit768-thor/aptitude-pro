# Copy this file to .env.local and fill in the values from your own Supabase
# project (Project Settings -> API). See README.md "Setup" for the full
# checklist. No accounts/auth in this app — these are just used to read the
# public content tables (companies/topics/questions) and, server-side only,
# to seed them.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never exposed to the browser. Used by scripts/seed/*.
SUPABASE_SERVICE_ROLE_KEY=
